{
  "name": "tuitify-website",
  "private": true,
  "version": "0.2.2",
  "description": "Build and browser checks for the Tuitify website",
  "scripts": {
    "build:css": "tailwindcss -i ./docs/assets/tailwind.css -o ./docs/assets/tailwind.compiled.css --minify",
    "build": "npm run build:css",
    "serve": "node ./scripts/serve.mjs",
    "test:browser": "npm run build:css && playwright test",
    "test": "npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "tailwindcss": "3.4.17"
  }
}
